# CareFlow env names only — never commit secret values.
#
# Local secrets: copy this file to .env, then `phantom init` and
# `phantom add VAR_NAME`. .env should hold Phantom tokens (phm_…), not
# plaintext keys. Never commit .env.
#
# DEMO_NOTIFY=1 means CI and local must not live-dial or SMS-blast
# (INV-21, S-34). Leave it 1 unless you are intentionally sending
# traffic to Africa’s Talking / Twilio / ElevenLabs / Pawa.
#
# docker-compose.yml hardcodes local-dev DB passwords for roles
# careflow_owner and careflow on database careflow. Those are
# developer-only defaults — do not paste them here as production secrets.
# App traffic uses DATABASE_URL (role careflow). Alembic uses
# DATABASE_ADMIN_URL (role careflow_owner). Ports: API 8000, Postgres 5432.

DATABASE_URL=
DATABASE_ADMIN_URL=
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DEMO_NOTIFY=1

# Admin SDK for FastAPI (GET /me + demo Auth seed). Not the web API key.
# Project: careflow-kenya. Generate a private key at:
# https://console.firebase.google.com/project/careflow-kenya/settings/serviceaccounts/adminsdk
# Then: phantom add FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

ELEVENLABS_API_KEY=
# Premade Daniel - Steady Broadcaster. Leave this set so TTS does not drift.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

PAWA_AI_API_KEY=
